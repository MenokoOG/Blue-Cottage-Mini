{
  "name": "blue-cottage-mini",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Blue Cottage Mini: A Tour of ITF Taekwon-Do. The 24 ITF patterns with a Master Instructor, belt and pattern agents, cited open sources and demonstration videos. PROTOTYPE - not production.",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:rules": "firebase emulators:exec --only firestore --project rules-test \"vitest run --config vitest.rules.config.mts\""
  },
  "dependencies": {
    "firebase": "13.0.0",
    "jose": "6.2.12",
    "next": "16.3.8",
    "openai": "7.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@next/eslint-plugin-next": "16.4.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false
  }
}
